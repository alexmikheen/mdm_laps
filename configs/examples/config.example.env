# GoLAPS Configuration Example
# Copy this file to .env or set these environment variables

# ======================
# Required Settings
# ======================

# Admin user for LAPS (REQUIRED - no default)
LAPS_ADMIN_USER="example-admin"

# Vault type: onepassword, hashicorp, bitwarden, aws, azure
LAPS_VAULT_TYPE="onepassword"

# Vault ID/Name (depends on vault provider)
LAPS_VAULT_ID="your-vault-id"

# Optional generic token alias for providers that use a single service token
LAPS_VAULT_TOKEN="your-vault-service-token"

# Password length (default: 18)
LAPS_PASSWORD_LENGTH=18

# ======================
# 1Password Settings
# ======================
# You can use OP_SERVICE_ACCOUNT_TOKEN instead of LAPS_VAULT_TOKEN.
OP_SERVICE_ACCOUNT_TOKEN="your-1password-service-account-token"

# ======================
# HashiCorp Vault Settings
# ======================
VAULT_ADDR="https://vault.example.com:8200"
# You can use VAULT_TOKEN instead of LAPS_VAULT_TOKEN.
VAULT_TOKEN="your-vault-token"
LAPS_VAULT_PATH="secret/data/laps"

# ======================
# Bitwarden Secrets Manager Settings
# ======================
BW_SERVER_URL="https://api.bitwarden.com"
BW_API_KEY="client_id:client_secret"
BW_ORG_ID="your-organization-id"

# ======================
# AWS Secrets Manager Settings
# ======================
AWS_REGION="us-east-1"
AWS_PROFILE="default"
# Or use environment variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY

# ======================
# Azure Key Vault Settings
# ======================
AZURE_TENANT_ID="your-tenant-id"
AZURE_CLIENT_ID="your-client-id"
AZURE_CLIENT_SECRET="your-client-secret"
AZURE_VAULT_URL="https://your-vault.vault.azure.net"

# ======================
# Notification Settings - Slack
# ======================
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# ======================
# Notification Settings - Email
# ======================
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT=587
EMAIL_FROM="laps@example.com"
EMAIL_TO="security-team@example.com"
EMAIL_USERNAME="laps@example.com"
EMAIL_PASSWORD="your-smtp-password"

# ======================
# Prometheus Metrics
# ======================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=":9090"

# ======================
# GUI Dialogs (optional, macOS)
# ======================
# Help link offered by the token-grant dialogs; omit to hide the help button.
# LAPS_SUPPORT_URL="https://support.example.com/laps"

# ======================
# Legacy Migration (optional)
# ======================
# LEGACY_ADMIN_PASS="previous-admin-password"
